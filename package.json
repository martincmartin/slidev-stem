{
  "name": "stem-talks",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "format": "prettier --write docs themes tools \"*.{md,json,yaml}\"",
    "format:check": "prettier --check docs themes tools \"*.{md,json,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-slidev": "^1.0.5"
  }
}
