{
  "name": "slidev-theme-field-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Field Notes: a house Slidev theme for the STEM talks, built on Ledger. A light theme: notebook cream paper, ink-blue accent, moss-green second.",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=53.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "colorSchema": "light",
      "fonts": {
        "sans": "IBM Plex Sans",
        "serif": "Fraunces",
        "mono": "IBM Plex Mono",
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "slidev-theme-ledger": "link:../ledger"
  }
}
