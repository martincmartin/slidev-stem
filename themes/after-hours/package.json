{
  "name": "slidev-theme-after-hours",
  "version": "0.1.0",
  "private": true,
  "description": "After-Hours Observatory: a house Slidev theme for the STEM talks, built on Ledger. A dark theme: navy paper, amber accent, sky-blue second.",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=53.0.0"
  },
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "colorSchema": "dark",
      "fonts": {
        "sans": "IBM Plex Sans",
        "serif": "Fraunces",
        "mono": "IBM Plex Mono",
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "slidev-theme-ledger": "link:../ledger"
  }
}
