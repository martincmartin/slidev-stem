{
  "name": "slidev-theme-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Ledger: the house Slidev theme for the STEM talks. Warm cream, deep blue, warm brown; Fraunces and IBM Plex, self-hosted.",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=53.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "colorSchema": "light",
      "fonts": {
        "sans": "IBM Plex Sans",
        "serif": "Fraunces",
        "mono": "IBM Plex Mono",
        "provider": "none"
      }
    }
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
