@@ -0,0 +1,171 @@
+// Prototype (tasks/2026-10-11-paper-discs): paper discs instead of clip discs.
+// Under each part that covers a clip disc today, a face in the paper's colour
+// hides what is under it, by the depth test, at any tilt. The deck shows them
+// with `?paper` in the URL (watch/instance.ts).
+
+import { INKS } from "../webgl/scene.ts";
+import type { Group, Mesh } from "../webgl/scene.ts";
+import type { Point2 } from "../webgl/mesh.ts";
+import type { Watch } from "./generate.ts";
+import { Motion } from "./model.ts";
+
+/** How the discs are made. */
+export interface PaperDiscOptions {
+  /** Slide px above the covering part's bottom. */
+  readonly raise: number;
+  /** The renderer's holdout flag (`Mesh.holdout`): with the exact line test,
+   *  the line test takes the disc's depth exactly. */
+  readonly holdout: boolean;
+  /** `Mesh.overlay`: a polygon offset toward the camera. */
+  readonly overlay: boolean;
+}
+
+/** What `addPaperDiscs` made: one disc for each covering part. */
+export interface PaperDisc {
+  readonly cover: Group;
+  readonly radius: number;
+  /** Slide px: the disc's height. */
+  readonly height: number;
+  /** The covering part's lowest mesh: the disc joins its pieces. */
+  readonly under: Mesh;
+  readonly mesh: Mesh;
+}
+
+/** Sides of a disc's polygon. */
+const SEGMENTS = 128;
+
+function circle(centre: readonly number[], radius: number): Point2[] {
+  return Array.from({ length: SEGMENTS }, (_, index): Point2 => {
+    const angle = (2 * Math.PI * index) / SEGMENTS;
+    return [
+      (centre[0] ?? 0) + radius * Math.cos(angle),
+      (centre[1] ?? 0) + radius * Math.sin(angle),
+    ];
+  });
+}
+
+/** The part of the convex polygon `subject` inside the convex polygon `clip`
+ *  (Sutherland and Hodgman). Both anticlockwise in x and y. */
+function clipPolygon(subject: Point2[], clip: Point2[]): Point2[] {
+  let result = subject;
+  for (const [index, [ax, ay]] of clip.entries()) {
+    const [bx, by] = clip[(index + 1) % clip.length] ?? [ax, ay];
+    const [ex, ey] = [bx - ax, by - ay];
+    const inside = ([x, y]: Point2): boolean =>
+      ex * (y - ay) - ey * (x - ax) >= 0;
+    const cross = ([px, py]: Point2, [qx, qy]: Point2): Point2 => {
+      const t =
+        (ex * (ay - py) - ey * (ax - px)) / (ex * (qy - py) - ey * (qx - px));
+      return [px + t * (qx - px), py + t * (qy - py)];
+    };
+    const input = result;
+    result = [];
+    for (const [at, current] of input.entries()) {
+      const previous = input[(at + input.length - 1) % input.length] ?? current;
+      if (inside(current)) {
+        if (!inside(previous)) result.push(cross(previous, current));
+        result.push(current);
+      } else if (inside(previous)) {
+        result.push(cross(previous, current));
+      }
+    }
+  }
+  return result;
+}
+
+/** Add a paper disc under each part that covers a clip disc today, to the
+ *  scene and to every piece that shows the part's lowest mesh: the clip
+ *  disc's centre and radius, inside the case (the bezel's radius), `raise`
+ *  above the part's bottom. The discs are in the case's group, which does not
+ *  move. It changes `watch.scene`: call it once, before a renderer reads the
+ *  scene. */
+export function addPaperDiscs(
+  watch: Watch,
+  options: PaperDiscOptions,
+): PaperDisc[] {
+  const rest = new Motion(watch).matrices(0, 0);
+  const covers = new Map<Group, { centre: Point2; radius: number }>();
+  for (const mesh of watch.scene.meshes) {
+    for (const disc of mesh.hiddenInside) {
+      covers.set(disc.by, { centre: [...disc.centre], radius: disc.radius });
+    }
+  }
+  const caseBand = watch.scene.meshes.find((mesh) => mesh.name === "case band");
+  if (!caseBand?.group) throw new Error("no case band");
+  const still = rest.get(caseBand.group);
+  if (!still) throw new Error("no matrix for the case band");
+  const [identity, shift] = [
+    [0, 1, 2, 4, 5, 6, 8, 9, 10].every(
+      (index, order) =>
+        Math.abs((still[index] ?? 0) - (order % 4 === 0 ? 1 : 0)) < 1e-6,
+    ),
+    [still[12] ?? 0, still[13] ?? 0, still[14] ?? 0] as const,
+  ];
+  if (!identity) throw new Error("the case's group turns or scales");
+  const made: PaperDisc[] = [];
+  for (const [cover, disc] of covers) {
+    const matrix = rest.get(cover);
+    if (!matrix) throw new Error(`no matrix for ${cover.name}`);
+    let under: Mesh | null = null;
+    let bottom = Infinity;
+    for (const mesh of watch.scene.meshes) {
+      if (mesh.group !== cover) continue;
+      for (let index = 2; index < mesh.triangles.length; index += 3) {
+        const [x, y, z] = [
+          mesh.triangles[index - 2] ?? 0,
+          mesh.triangles[index - 1] ?? 0,
+          mesh.triangles[index] ?? 0,
+        ];
+        const height =
+          (matrix[2] ?? 0) * x +
+          (matrix[6] ?? 0) * y +
+          (matrix[10] ?? 0) * z +
+          (matrix[14] ?? 0);
+        if (height < bottom) {
+          bottom = height;
+          under = mesh;
+        }
+      }
+    }
+    if (!under) throw new Error(`no mesh in ${cover.name}`);
+    const height = bottom + options.raise;
+    const outline = clipPolygon(
+      circle(disc.centre, disc.radius),
+      circle(watch.design.watchCentre, watch.design.case.bezelRadius),
+    ).map(([x, y]): Point2 => [x - shift[0], y - shift[1]]);
+    const z = height - shift[2];
+    const [middleX, middleY] = [0, 1].map(
+      (axis) =>
+        outline.reduce((sum, point) => sum + (point[axis] ?? 0), 0) /
+        outline.length,
+    );
+    const triangles: number[] = [];
+    for (const [index, [ax, ay]] of outline.entries()) {
+      const [bx, by] = outline[(index + 1) % outline.length] ?? [ax, ay];
+      triangles.push(middleX ?? 0, middleY ?? 0, z, ax, ay, z, bx, by, z);
+    }
+    const mesh: Mesh = {
+      name: `${cover.name} paper disc`,
+      part: "paper disc",
+      group: caseBand.group,
+      // opacity 0: the paper's colour, opaque
+      fill: { ink: INKS.subjectWash, opacity: 0 },
+      hiddenInside: [],
+      lineOrder: under.lineOrder,
+      inDrawing: false,
+      overlay: options.overlay,
+      holdout: options.holdout,
+      dynamic: false,
+      triangles: new Float32Array(triangles),
+      lines: [],
+      silhouetteEdges: [],
+    };
+    // Prototype: the scene's lists are read-only in their types, not in fact
+    (watch.scene.meshes as Mesh[]).push(mesh);
+    for (const piece of watch.scene.pieces) {
+      if (piece.meshes.has(under)) (piece.meshes as Set<Mesh>).add(mesh);
+    }
+    made.push({ cover, radius: disc.radius, height, under, mesh });
+  }
+  return made;
+}
