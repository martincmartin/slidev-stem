{
  "name": "watches",
  "type": "module",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "pnpm --dir .. install --frozen-lockfile",
    "build": "slidev build",
    "article": "slidev build && pnpm prerender",
    "prerender": "node addons/narration/prerender.ts dist",
    "dev": "slidev",
    "export": "slidev export --with-clicks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"webgl/**/*.test.ts\" \"watch/**/*.test.ts\" \"addons/**/*.test.ts\" && uv run art/test_leader_path.py && uv run art/test_favicon.py",
    "explore": "vite watch/explorer --open",
    "art:scene": "node watch/dump.ts",
    "art:generated": "uv run art/diving_board.py --check && uv run art/watch_design.py --check && uv run art/favicon.py --check",
    "art:stills": "uv run art/watch_stills.py",
    "art:print": "uv run art/print_check.py",
    "art:privacy": "uv run art/privacy_check.py"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "earcut": "^3.2.4",
    "slidev-addon-palette-after-hours": "link:../themes/palettes/after-hours",
    "slidev-addon-palette-beacon": "link:../themes/palettes/beacon",
    "slidev-addon-palette-campfire": "link:../themes/palettes/campfire",
    "slidev-addon-palette-electric-terracotta": "link:../themes/palettes/electric-terracotta",
    "slidev-addon-palette-field-notes": "link:../themes/palettes/field-notes",
    "slidev-addon-palette-kraft-ink": "link:../themes/palettes/kraft-ink",
    "slidev-addon-palette-ledger": "link:../themes/palettes/ledger",
    "slidev-theme-house": "link:../themes/house",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@slidev/parser": "53.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "playwright-chromium": "1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-slidev": "^1.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vue-tsc": "^3.3.13"
  }
}
